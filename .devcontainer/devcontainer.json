{
  "name": "vscode-sas-extension",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-lts",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "11",
      "installMaven": "true",
      "installGradle": "false"
    }
  },
  "postCreateCommand": "npm install && npm install -g @vscode/vsce",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vscjava.vscode-java-pack"
      ],
      "settings": {
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-11",
            "default": true
          }
        ]
      }
    }
  },
  "remoteUser": "node"
}
